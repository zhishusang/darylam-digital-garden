---
import BaseLayout from "./BaseLayout.astro";
import AudioPlayer from "../components/AudioPlayer.astro";

type Props = {
  title: string;
  description?: string;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  audio?: { src: string; title?: string };
};

const { title, description, pubDate, updatedDate, tags, audio } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="prose card">
    <header>
      <h1>{title}</h1>
      <div class="meta">
        {pubDate ? <span>{pubDate.toISOString().slice(0, 10)}</span> : null}
        {updatedDate ? <span>更新 {updatedDate.toISOString().slice(0, 10)}</span> : null}
        {tags?.length ? (
          <span>
            {tags.map((t) => (
              <span class="tag">#{t}</span>
            ))}
          </span>
        ) : null}
      </div>
    </header>

    {audio?.src ? <AudioPlayer src={audio.src} title={audio.title} /> : null}

    <div class="content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .content :global(h1:first-child) {
    display: none;
  }

  .content :global(img) {
    display: block;
    width: auto;
    max-width: min(100%, 720px);
    height: auto;
    max-height: 72vh;
    margin: 22px auto;
    border-radius: 4px;
  }

  .content :global(p > img:only-child) {
    margin: 18px auto 22px;
  }
</style>
