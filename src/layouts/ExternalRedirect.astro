---
type Props = {
  title: string;
  target: string;
  label?: string;
};

const { title, target, label = "Continue" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <link rel="canonical" href={target} />
  </head>
  <body>
    <main style="padding: 48px 20px; font-family: ui-sans-serif, system-ui, sans-serif;">
      <p style="margin: 0; color: #666;">
        Moving to <a href={target}>{label}</a>...
      </p>
    </main>
  </body>
</html>
