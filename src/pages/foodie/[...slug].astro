---
import { getCollection, type CollectionEntry } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";

export async function getStaticPaths() {
  function hasPublicAsset(src: string) {
    const decoded = decodeURIComponent(src);
    return existsSync(join(process.cwd(), "public", decoded.replace(/^\//, "")));
  }

  function rawMarkdown(filepath: string | undefined) {
    if (!filepath) return "";
    const absolutePath = join(process.cwd(), filepath);
    return existsSync(absolutePath) ? readFileSync(absolutePath, "utf-8") : "";
  }

  function hasVisibleImage(markdown: string | undefined) {
    if (!markdown) return false;
    const matches = [...markdown.matchAll(/!\[[^\]]*\]\(([^)]+)\)/g)];
    return matches.some((match) => Boolean(match[1] && hasPublicAsset(match[1])));
  }

  const entries = await getCollection("foodie");
  return entries
    .filter((entry) => !entry.data.draft && hasVisibleImage(rawMarkdown(entry.filePath)))
    .map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

type Props = { entry: CollectionEntry<"foodie"> };
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<ContentLayout
  title={entry.data.title}
  description={entry.data.description}
  updatedDate={entry.data.updatedDate}
  tags={entry.data.tags}
>
  <Content />
</ContentLayout>
