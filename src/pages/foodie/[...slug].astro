---
import { getCollection, type CollectionEntry } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";

export async function getStaticPaths() {
  function hasPublicAsset(src: string) {
    const decoded = decodeURIComponent(src);
    return existsSync(fileURLToPath(new URL(`../../../public${decoded}`, import.meta.url)));
  }

  function hasVisibleImage(markdown: string | undefined) {
    if (!markdown) return false;
    const matches = [...markdown.matchAll(/!\[[^\]]*\]\(([^)]+)\)/g)];
    return matches.some((match) => Boolean(match[1] && hasPublicAsset(match[1])));
  }

  const entries = await getCollection("foodie");
  return entries
    .filter((entry) => !entry.data.draft && hasVisibleImage(entry.body))
    .map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

type Props = { entry: CollectionEntry<"foodie"> };
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<ContentLayout
  title={entry.data.title}
  description={entry.data.description}
  updatedDate={entry.data.updatedDate}
  tags={entry.data.tags}
>
  <Content />
</ContentLayout>
