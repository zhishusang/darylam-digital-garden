---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { existsSync, readFileSync, readdirSync } from "node:fs";
import { join } from "node:path";

function hasPublicAsset(src: string) {
  const decoded = decodeURIComponent(src);
  return existsSync(join(process.cwd(), "public", decoded.replace(/^\//, "")));
}

function firstImage(markdown: string | undefined) {
  if (!markdown) return null;
  const matches = [...markdown.matchAll(/!\[[^\]]*\]\(([^)]+)\)/g)];
  for (const match of matches) {
    const candidate = match[1];
    if (candidate && hasPublicAsset(candidate)) return candidate;
  }
  return null;
}

function excerpt(markdown: string | undefined) {
  if (!markdown) return "";
  return markdown
    .replace(/!\[[^\]]*\]\([^)]+\)/g, " ")
    .replace(/\[[^\]]+\]\([^)]+\)/g, " ")
    .replace(/^#{1,6}\s+/gm, "")
    .replace(/[*_`>~-]/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .slice(0, 150);
}

function frontmatterValue(source: string, key: string) {
  const match = source.match(new RegExp(`^${key}:\\s*["']?(.*?)["']?\\s*$`, "m"));
  return match?.[1]?.trim() ?? "";
}

const foodieDir = join(process.cwd(), "src", "content", "foodie");

const entries = readdirSync(foodieDir)
  .filter((name) => name.endsWith(".md"))
  .map((name) => {
    const absolutePath = join(foodieDir, name);
    const source = readFileSync(absolutePath, "utf-8");
    const parts = source.split("---");
    const frontmatter = parts[1] ?? "";
    const body = parts.slice(2).join("---").trim();
    const image = firstImage(body);
    const draft = frontmatterValue(frontmatter, "draft") === "true";
    const title = frontmatterValue(frontmatter, "title");
    const description = frontmatterValue(frontmatter, "description");
    const updatedDate = frontmatterValue(frontmatter, "updatedDate");
    const indexValue = Number(frontmatterValue(frontmatter, "index"));

    return {
      slug: name.replace(/\.md$/, "").replace(/\s+/g, "-"),
      title,
      image,
      text: description || excerpt(body) || "Kitchen note in progress.",
      updatedDate,
      index: Number.isFinite(indexValue) ? indexValue : 999999,
      draft,
    };
  })
  .filter((entry) => !entry.draft && entry.image)
  .sort((a, b) => a.index - b.index);
---

<BaseLayout title="Foodie" description="Recipes and kitchen notes from Dary's daily learning.">
  <section class="foodie-hero">
    <h1>Foodie</h1>
    <p>Recipes, experiments, and stories from my kitchen.</p>
  </section>

  <section class="strip-list">
    {entries.map((entry) => (
      <a class="strip" href={`/foodie/${entry.slug}`}>
        <img src={entry.image} alt={entry.title} loading="lazy" decoding="async" />
        <div class="copy">
          <p class="index">{typeof entry.index === "number" ? String(entry.index).padStart(3, "0") : "—"}</p>
          <h2>{entry.title}</h2>
          <p class="text">{entry.text}</p>
          <time>{entry.updatedDate}</time>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .foodie-hero {
    padding: 28px 0 26px;
    max-width: 56ch;
  }
  .foodie-hero h1 {
    margin: 0;
    font-family: var(--serif);
    font-size: 42px;
    font-weight: 400;
  }
  .foodie-hero p {
    margin: 10px 0 0;
    color: var(--muted);
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.6;
  }

  .strip-list {
    display: grid;
    gap: 16px;
    padding-bottom: 120px;
  }

  .strip {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 18px;
    padding: 14px;
    border: 1px solid color-mix(in oklab, var(--border) 78%, transparent);
    color: inherit;
    text-decoration: none;
    align-items: center;
    background: color-mix(in oklab, var(--bg) 93%, white);
  }

  .strip img {
    width: 100%;
    height: 124px;
    object-fit: cover;
    border-radius: 3px;
    border: 1px solid color-mix(in oklab, var(--border) 78%, transparent);
  }
  .copy .index {
    margin: 0;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.08em;
  }
  .copy h2 {
    margin: 6px 0 6px;
    font-family: var(--serif);
    font-size: 25px;
    font-weight: 400;
    line-height: 1.2;
  }
  .copy .text {
    margin: 0 0 8px;
    color: color-mix(in oklab, var(--text) 82%, transparent);
    line-height: 1.55;
  }
  .copy time {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }

  @media (max-width: 740px) {
    .strip {
      grid-template-columns: 1fr;
    }
    .strip img {
      height: 188px;
    }
  }
</style>
