---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const items = (await getCollection("programs"))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0));
---

<BaseLayout title="Programs — Dary's Digital Garden" description="Public projects Dary is building in the open.">
  <section class="programs-intro">
    <p class="programs-kicker">Programs</p>
    <p class="programs-note">
      Slow public projects, built in the open and meant to leave something useful behind.
    </p>
  </section>
  <section class="programs-list">
    {items.map((item, index) => (
      <a class="program-row" href={`/programs/${item.slug}`}>
        <div class="program-meta">
          <span>{String(index + 1).padStart(2, "0")}</span>
          {item.data.pubDate ? <span>{item.data.pubDate.toISOString().slice(0, 10)}</span> : null}
          {item.data.status ? <span>{item.data.status}</span> : null}
        </div>
        <div class="program-main">
          <div>
            <h2>{item.data.title}</h2>
            <p>{item.data.description}</p>
          </div>
          <span class="program-arrow" aria-hidden="true">↗</span>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .programs-intro {
    padding-top: 12px;
    margin-bottom: 34px;
  }

  .programs-kicker {
    margin: 0 0 8px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .programs-note {
    margin: 0;
    max-width: 34ch;
    font-family: var(--serif);
    font-size: 20px;
    line-height: 1.62;
    color: color-mix(in oklab, var(--text) 84%, transparent);
  }

  .programs-list {
    display: grid;
    gap: 28px;
  }

  .program-row {
    display: block;
    color: var(--text);
    padding-bottom: 26px;
    border-bottom: 1px solid color-mix(in oklab, var(--border) 88%, transparent);
  }

  .program-meta {
    display: flex;
    gap: 14px;
    margin-bottom: 10px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .program-main {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }

  .program-row h2 {
    margin: 0 0 10px;
    font-family: var(--serif);
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 400;
    line-height: 1.12;
  }

  .program-row p {
    margin: 0;
    max-width: 34ch;
    font-family: var(--serif);
    font-size: 19px;
    line-height: 1.65;
    color: color-mix(in oklab, var(--text) 86%, transparent);
  }

  .program-arrow {
    margin-top: 8px;
    color: var(--muted);
    font-size: 18px;
    flex: 0 0 auto;
  }
</style>
