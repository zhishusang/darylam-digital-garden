---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Dary's Digital Garden" description="A minimalist entry to Dary Lam's digital garden.">
  <section class="home-intro">
    <h2>Dary Lam,</h2>
    <div class="wind-fence" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span><span></span>
    </div>
    <p>
      10+ years writing. Into photography. Daily cooking. Deep-talk walks.
      Vintage hunting. I love creating things.
    </p>
    <nav class="home-nav" aria-label="Primary">
      <a href="/">/home</a>
      <a href="/foodie">/foodie</a>
      <a href="/travel">/travel</a>
      <a href="/blog">/blog</a>
      <a href="/thoughts">/thoughts</a>
      <a href="/diary">/diary</a>
      <a href="/weapons">/weapons</a>
      <a href="/about">/about</a>
    </nav>
  </section>
</BaseLayout>

<style>
  .home-intro {
    padding: 110px 0 180px;
    max-width: 44ch;
  }

  .home-intro h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(34px, 7vw, 56px);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.08;
  }

  .wind-fence {
    margin: 16px 0 20px;
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .wind-fence span {
    height: 1px;
    background: color-mix(in oklab, var(--text) 24%, transparent);
    border-radius: 999px;
    transform-origin: left center;
    animation: fenceWave 4.2s ease-in-out infinite;
  }

  .wind-fence span:nth-child(1) { width: 30px; animation-delay: -0.1s; }
  .wind-fence span:nth-child(2) { width: 46px; animation-delay: -0.35s; }
  .wind-fence span:nth-child(3) { width: 62px; animation-delay: -0.55s; }
  .wind-fence span:nth-child(4) { width: 48px; animation-delay: -0.22s; }
  .wind-fence span:nth-child(5) { width: 34px; animation-delay: -0.48s; }
  .wind-fence span:nth-child(6) { width: 18px; animation-delay: -0.3s; }

  @keyframes fenceWave {
    0%, 100% { transform: scaleX(1) translateY(0); opacity: 0.42; }
    50% { transform: scaleX(1.18) translateY(-0.5px); opacity: 0.78; }
  }

  .home-intro p {
    margin: 0;
    color: color-mix(in oklab, var(--text) 88%, transparent);
    font-family: var(--serif);
    font-size: 20px;
    line-height: 1.6;
  }

  .home-nav {
    margin-top: 30px;
    display: flex;
    gap: 16px;
    font-family: var(--mono);
    font-size: 12px;
    white-space: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    mask-image: linear-gradient(to right, black 0%, black 86%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, black 0%, black 86%, transparent 100%);
  }
  .home-nav::-webkit-scrollbar {
    display: none;
  }

  .home-nav a {
    flex: 0 0 auto;
    color: var(--muted);
  }

  .home-nav a:hover {
    color: var(--text);
  }
</style>
