---
import BaseLayout from "../../layouts/BaseLayout.astro";

const notesUrl = "https://notes.darylam.com";
---

<BaseLayout title="Notes — Dary's Digital Garden" description="A gentle bridge from the garden to Dary's separate writing space.">
  <section class="notes-bridge">
    <p class="kicker">Notes</p>
    <h1>A lighter writing space, just next door.</h1>
    <p class="lead">
      Longer articles, fragments, reading traces, and more frequent updates now live in a separate
      notebook. I keep it apart so this garden can stay calm, while the writing side can keep moving.
    </p>

    <div class="actions">
      <a class="primary" href={notesUrl} target="_blank" rel="noreferrer">Open notes.darylam.com ↗</a>
      <a class="secondary" href="/about">Back to the garden</a>
    </div>

    <p class="hint">
      If you open it and want to come back, this garden will still be here.
    </p>
  </section>
</BaseLayout>

<style>
  .notes-bridge {
    padding-top: 16px;
    max-width: 34rem;
  }

  .kicker {
    margin: 0 0 8px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .notes-bridge h1 {
    margin: 0 0 14px;
    font-family: var(--serif);
    font-size: clamp(30px, 5vw, 42px);
    font-weight: 400;
    line-height: 1.14;
  }

  .lead,
  .hint {
    margin: 0;
    font-family: var(--serif);
    line-height: 1.72;
  }

  .lead {
    font-size: 19px;
    color: color-mix(in oklab, var(--text) 88%, transparent);
  }

  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin: 28px 0 18px;
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid color-mix(in oklab, var(--border) 88%, transparent);
  }

  .actions .primary {
    background: color-mix(in oklab, var(--bg) 84%, var(--text) 6%);
    color: var(--text);
  }

  .actions .secondary {
    color: var(--muted);
  }

  .hint {
    color: var(--muted);
    font-size: 14px;
  }
</style>
