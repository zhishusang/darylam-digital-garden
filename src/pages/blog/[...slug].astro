---
import { getCollection } from "astro:content";
import ExternalRedirect from "../../layouts/ExternalRedirect.astro";

const notesUrl = "https://notes.darylam.com";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.slug } }));
}
---

<ExternalRedirect title="Writing moved" target={notesUrl} label="notes.darylam.com" />
