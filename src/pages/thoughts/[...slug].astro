---
import { getCollection } from "astro:content";
import ExternalRedirect from "../../layouts/ExternalRedirect.astro";

const notesUrl = "https://notes.darylam.com";

export async function getStaticPaths() {
  const notes = await getCollection("garden");
  return notes.map((note) => ({ params: { slug: note.slug } }));
}
---

<ExternalRedirect title="Thoughts moved" target={notesUrl} label="notes.darylam.com" />
